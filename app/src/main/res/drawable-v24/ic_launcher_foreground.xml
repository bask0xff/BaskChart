<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Rounded app icon background -->
    <path
        android:pathData="M54,0 L54,0 C83.823,0 108,24.177 108,54 L108,54 C108,83.823 83.823,108 54,108 L54,108 C24.177,108 0,83.823 0,54 L0,54 C0,24.177 24.177,0 54,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#4A90E2" />
                <item android:offset="1" android:color="#357ABD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Chart grid lines (subtle) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M25,65 L85,65 M25,75 L85,75 M25,85 L85,85" />

    <!-- Vertical axis line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M28,28 L28,88" />

    <!-- Horizontal axis line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M24,85 L85,85" />

    <!-- Chart bars -->
    <rect
        android:width="12"
        android:height="30"
        android:x="38"
        android:y="55"
        android:fillColor="#FFFFFF"
        android:rx="2" />

    <rect
        android:width="12"
        android:height="48"
        android:x="56"
        android:y="37"
        android:fillColor="#FFFFFF"
        android:rx="2" />

    <rect
        android:width="12"
        android:height="18"
        android:x="74"
        android:y="67"
        android:fillColor="#FFFFFF"
        android:rx="2" />

    <!-- Line chart overlay on bars -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD700"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,78 L44,58 L62,40 L80,68" />

    <!-- Data points on line -->
    <circle
        android:cx="32"
        android:cy="78"
        android:r="4"
        android:fillColor="#FFD700" />
    <circle
        android:cx="44"
        android:cy="58"
        android:r="4"
        android:fillColor="#FFD700" />
    <circle
        android:cx="62"
        android:cy="40"
        android:r="4"
        android:fillColor="#FFD700" />
    <circle
        android:cx="80"
        android:cy="68"
        android:r="4"
        android:fillColor="#FFD700" />
</vector>